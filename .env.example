# ── Database ──────────────────────────────────────────────────────────────────
# Dev: direct connection (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reddit_monitor_dev
# Production (Supabase): use pgbouncer port 6543 + connection_limit=1 for serverless
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1
POSTGRES_PASSWORD=postgres

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Verified sender domain in Resend dashboard
RESEND_FROM_EMAIL=hello@radarscout.io

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Tiqets Affiliate Content API ─────────────────────────────────────────────
# Server-side only. Provides read-only catalogue and availability access.
# Never expose through NEXT_PUBLIC_* variables or return raw upstream payloads.
TIQETS_API_TOKEN=

# ── Bókun ─────────────────────────────────────────────────────────────────────
# Server-side only. Never expose these through NEXT_PUBLIC_* variables.
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_API_BASE_URL=https://api.bokun.io
BOKUN_DEFAULT_CURRENCY=USD
# Shared secret for triggering the server-only Bókun sync endpoint.
BOKUN_SYNC_SECRET=

# ── Internal API ──────────────────────────────────────────────────────────────
# Shared secret for server-side sync endpoints. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
# Shared secret for local AI enrichment preview endpoints. Generate with: openssl rand -hex 32
INTERNAL_AI_PREVIEW_SECRET=
# Shared secret for saving manually reviewed enrichment. Generate with: openssl rand -hex 32
INTERNAL_ENRICHMENT_REVIEW_SECRET=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# ── Optional AI trip narration (server-only) ─────────────────────────────────
# Requires an explicit flag, a model key, and REDIS_URL before the paid public
# endpoint can run. Never expose any of these through NEXT_PUBLIC_* variables.
AI_TRIP_NARRATION_ENABLED=false
ANTHROPIC_API_KEY=
# Optional model override; defaults to a small fast model in code.
AI_TRIP_NARRATION_MODEL=

# ── Optional Local AI helper (server-only) ───────────────────────────────────
# For low-risk text tasks only. Never expose through NEXT_PUBLIC_* variables.
LOCAL_AI_PROVIDER=openwebui
OPENWEBUI_BASE_URL=http://localhost:3000
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=gemma4
# Optional: Cloudflare Access Service Token for tunnel-protected Open WebUI.
# Both variables must be set together — setting only one returns a safe error.
# Generate via: Cloudflare Zero Trust → Access → Service Tokens.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# ── Optional legacy SaaS integrations ─────────────────────────────────────────
# Keep unset for the Thailand travel MVP unless these flows are intentionally enabled.
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_TEAM_ANNUAL_PRICE_ID=price_...
INTERNAL_API_URL=http://localhost:3000
