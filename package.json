{
  "name": "reddit-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @reddit-monitor/web dev",
    "build": "pnpm --filter @reddit-monitor/db generate && pnpm --filter @reddit-monitor/web build",
    "crawler": "pnpm --filter @reddit-monitor/crawler start",
    "db:generate": "pnpm --filter @reddit-monitor/db generate",
    "db:migrate:dev": "pnpm --filter @reddit-monitor/db migrate:dev",
    "db:studio": "pnpm --filter @reddit-monitor/db studio",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:vercel-preview-guard": "node --test scripts/__tests__/radarscout-vercel-preview-guard.test.js",
    "test:vercel-preview-deploy": "node --test scripts/__tests__/radarscout-vercel-preview-deploy.test.js",
    "guard:vercel-preview": "node scripts/radarscout-vercel-preview-guard.js",
    "deploy:vercel-preview": "node scripts/radarscout-vercel-preview-deploy.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "smoke:ai-trip-preview": "pnpm --filter @reddit-monitor/web exec node ../../scripts/radarscout-ai-trip-preview-smoke.js"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
